+BossOverride const* GetBossOverride(uint32 creatureEntry)
+{
+    InitBossOverrides();
+    auto it = s_bossOverrides.find(creatureEntry);
+    return (it != s_bossOverrides.end()) ? &it->second : nullptr;
+}
