+    if (spellId && !me->IsNonMeleeSpellCasted(false))
+    {
+        if (!me->IsInCombat())
+            me->Attack(target, false);
+        me->SetFacingToObject(target);
+        if (!me->movespline->Finalized())
+            me->StopMoving();
+        me->CastSpell(target, spellId, false);
+    }
