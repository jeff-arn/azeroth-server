+        return false;
+
+    // Per CLASS_GROUP_BEHAVIOR_GUIDE threat rules
+    if (m_role == ROLE_MELEE_DPS)
+        return ratio >= 0.90f;
+    else // ROLE_RANGE_DPS
+        return ratio >= 0.90f;
