+BossOverride const* PartyBotAI::GetCurrentBossOverride() const
+{
+    if (Unit* pVictim = me->GetVictim())
+    {
+        if (Creature* pCreature = pVictim->ToCreature())
+            return GetBossOverride(pCreature->GetEntry());
+    }
+    return nullptr;
+}
