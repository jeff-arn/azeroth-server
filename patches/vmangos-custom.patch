+            // Too close, back up
+            float x = me->GetPositionX();
+            float y = me->GetPositionY();
+            float z = me->GetPositionZ();
+            float d = me->GetDistance(target);
+            if (d > 0)
+            {
+                x += (x - target->GetPositionX()) * 10.0f / d;
+                y += (y - target->GetPositionY()) * 10.0f / d;
