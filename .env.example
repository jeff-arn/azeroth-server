# Azeroth Server secrets — copy to .env and fill in values.
# Loaded by Python services (dashboard, discord-bot) via systemd EnvironmentFile.
# The C++ services read their own credentials from mangosd.conf / realmd.conf
# (also gitignored — see *.conf.example for templates).

# --- Database (read by dashboard and discord-bot) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mangos
DB_PASSWORD=

# --- Discord (discord-bot only) ---
DISCORD_BOT_TOKEN=

# --- Flask (dashboard only; optional) ---
# If unset, the dashboard generates an ephemeral key per-process — sessions
# don't survive a restart. Set this to a long random string for persistent
# session signing.
FLASK_SECRET_KEY=

# --- Paths (optional, with sensible defaults) ---
# Path to the world server's LevelUp.log, tailed by the discord-bot.
LEVELUP_LOG=/home/wow/wow-private-server/vmangos/run/bin/LevelUp.log
